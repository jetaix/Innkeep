{
  "name": "innkeep",
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/zip-extension.mjs",
    "build": "next build",
    "start": "next start",
    "app": "node scripts/start.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "build:safari": "node scripts/build-safari.mjs",
    "lint": "biome lint .",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit && bun scripts/check-awaits.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && bun run typecheck && bun run test && bun run build",
    "prepare": "node scripts/hooks.mjs",
    "web:check": "cd web && bun install --frozen-lockfile && bun run build && bun run check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "private": true,
  "description": "Open-source, self-hosted channel manager for hosts with one or two rentals",
  "engines": {
    "node": "22.x || 24.x"
  },
  "packageManager": "bun@1.4.4"
}
