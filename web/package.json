{
  "name": "innkeep-web",
  "private": true,
  "type": "module",
  "description": "The client-rendered Innkeep: a Vite app and the HTTP API it talks to. Replaces the Next.js app at cutover.",
  "scripts": {
    "dev": "bun run dev:api & vite",
    "dev:app": "vite",
    "dev:api": "bun --conditions=react-server --watch server/dev.ts",
    "build": "vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && bun scripts/prerender.ts && bun scripts/budget.ts",
    "build:react-dom": "RENDERER=react-dom vite build",
    "check": "tsc --noEmit",
    "budget": "bun scripts/budget.ts"
  },
  "dependencies": {
    "@fontsource-variable/funnel-display": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/redact": "0.3.1",
    "hono": "4.13.21",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@rolldown/plugin-babel": "0.3.1",
    "@stylexjs/unplugin": "0.19.2",
    "@tanstack/router-plugin": "1.169.0",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
