{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!docs/ALTERNATIVES.md", "!docs/store", "!docs/screenshots", "!bun.lock"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noCommaOperator": "off",
        "noImportantStyles": "off",
        "useMathMinMax": "off"
      },
      "performance": {
        "useDomNodeTextContent": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noNoninteractiveTabindex": "off",
        "useAriaPropsSupportedByRole": "off",
        "noSvgWithoutTitle": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "useIterableCallbackReturn": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["extension/**", "scripts/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off",
            "noMisusedPromises": "off"
          }
        }
      }
    }
  ]
}
